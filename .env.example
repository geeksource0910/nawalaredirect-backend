# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── JWT Secret (wajib diganti! generate dengan: openssl rand -hex 32) ────────
JWT_SECRET=ganti_dengan_random_string_panjang_minimal_32_karakter

# ─── Dashboard Admin ──────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_kuat_disini

# ─── CORS (URL dashboard frontend kamu) ──────────────────────────────────────
ALLOWED_ORIGINS=https://your-dashboard.vercel.app,http://localhost:5173

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_BOT_USERNAME=NamaBotKamu
# Secret untuk validasi webhook (set saat daftar webhook ke Telegram)
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Scheduler ────────────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30     # menit
REPORT_INTERVAL=4            # jam
HEALTH_CHECK_TIMEOUT=10000   # ms

# ─── Indiwtf API (https://indiwtf.com/pricing) ────────────────────────────────
INDIWTF_TOKEN=your_indiwtf_api_token_here

# ─── Backend URL (untuk setup webhook) ────────────────────────────────────────
BACKEND_URL=https://akseslinkresmi.com
